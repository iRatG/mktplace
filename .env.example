# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=mktplace
POSTGRES_USER=mktplace_user
POSTGRES_PASSWORD=mktplace_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@mktplace.com

# Защита от ботов (apps/users/security.py).
# Капча Cloudflare Turnstile: пока ключи пустые, капча выключена, остальная защита работает.
# Ключи выдаёт Cloudflare (Dashboard → Turnstile → Add site); в репозиторий их не класть.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# RATELIMIT_ENABLED=False отключает все лимиты (только для отладки).
# RATELIMIT_MULTIPLIER=10 ослабляет лимиты приложения в 10 раз (на время массового тестирования).
# Автоблок IP по правилу (apps/users/blocklist.py). Выключен по умолчанию: включать только
# после того, как порт приложения (8080) закрыт для интернета, иначе подменой заголовка
# X-Real-IP можно заблокировать чужой адрес. Ручные блокировки (Django admin) работают всегда.
AUTOBLOCK_ENABLED=False
# AUTOBLOCK_STRIKES=10   # штрафов за AUTOBLOCK_WINDOW секунд (3600) -> блок на AUTOBLOCK_HOURS часов (24)

# Platform settings
PLATFORM_COMMISSION_PERCENT=15

# Currency (Узбекистан — сум/UZS по умолчанию в config/settings/base.py,
# переопределять здесь нужно только для другой страны)
CURRENCY_SYMBOL=сум
CURRENCY_CODE=UZS
CURRENCY_MIN_WITHDRAWAL=65000
CURRENCY_MIN_DEPOSIT=130000

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:8000

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
